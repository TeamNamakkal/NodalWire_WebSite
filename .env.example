# SMTP settings for the "forgot password" email feature.
# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="NodalWire <your-email@gmail.com>"

# Base URL used to build the password reset link sent in the email.
SITE_BASE_URL=http://localhost:3000

# Lead Management: comma-separated emails notified when a new lead is created.
# Uses the same SMTP settings above. Leave unset to skip notification silently.
LEAD_NOTIFICATION_EMAILS=you@nodalwire.com,julius@nodalwire.com

# Lead Management AI Assistant (architecture only — no provider implemented yet).
# Set to openai | anthropic | gemini once an adapter in scripts/lib/ai-provider.mjs
# is implemented and the matching API key below is set. Leave as "none" (or unset)
# to keep the AI Assistant buttons showing "AI integration not configured."
AI_PROVIDER=none
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
